{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":preserveSemverRanges",
    "config:best-practices",
    "replacements:all"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"]
}
