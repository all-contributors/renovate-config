{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    ":preserveSemverRanges",
    "config:best-practices",
    "replacements:all"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["pnpm-lock.yaml"],
      "postUpdateOptions": ["pnpmDedupe"]
    }
  ]
}
